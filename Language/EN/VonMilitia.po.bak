msgid "TERATORIAL@E01@TRITDSCRIPT"
msgstr "When inside friendly domain this unit get +1 {GLOBAL.DefenseConcept.Hyperlink} and {GLOBAL.ResistanceConcept.Hyperlink}."

msgid "HOMAGURAD@E01@TRITDSCRIPT"
msgstr "When Inside friendly city domain this unit get:[bulletlist][bullet/]+20% damage.[bullet/]+20 {GLOBAL.UnitMoraleConcept.Hyperlink}.[bullet/]{GLOBAL.UnitUpkeepConcept.Hyperlink} is decreased by -30%.[br/][br/]When inside enemy city domain:[bulletlist][bullet/]-30% damage.[bullet/]-30 {GLOBAL.UnitMoraleConcept.Hyperlink}.[bullet/]{GLOBAL.UnitUpkeepConcept.Hyperlink} is decreased by -30%."

msgid "MOBACONSCRIPT@TRITDSCRIPT"
msgstr "Unit suffer no negative effects from {GLOBAL.PROPERTIES.HOMGUA.Hyperlink} when inside enemy city domain."

msgid "MARTIALATRAINING@TRITDSCRIPT"
msgstr "Unit gets extra bonuses with every rank:[bulletlist][bullet/] +3<<m:{GLOBAL.HitPointConcept.Hyperlink}>>[bullet/]+1{GLOBAL.PhysicalDamageConcept.Hyperlink}."

msgid "MANAACOUNTENT@TRITDSCRIPT"
msgstr "Units in this army requier 10% less {GLOBAL.ManaConcept.Hyperlink} upkeep. This bonus stacks."

msgid "CAMPFOLOWER@TRITDSCRIPT"
msgstr "Units regenerate an additional +10<<m:{GLOBAL.HitPointConcept.Hyperlink}>> on the strategic map. This bonus stacks."

msgid "GRAISONA@E01@TRITDSCRIPT"
msgstr "All racial tier I units get:[bulletlist][bullet/]{GLOBAL.UnitUpkeepConcept.Hyperlink} is decreased by -40%.[bullet/]1+ {GLOBAL.DefenseConcept.Hyperlink} and {GLOBAL.ResistanceConcept.Hyperlink}.[/bulletlist]When Inside friendly city domain racial tier I unit without {GLOBAL.PROPERTIES.HOMGUA.Hyperlink} get:[bulletlist][bullet/]+20% damage.[bullet/]+20 {GLOBAL.UnitMoraleConcept.Hyperlink}."

msgid "LEVEYORGANZER@TRITDSCRIPT"
msgstr "Units in this army with {GLOBAL.PROPERTIES.HOMGUA.Hyperlink} get:[bulletlist][bullet/]+1 {GLOBAL.DefenseConcept.Hyperlink}.[bullet/]+2{GLOBAL.PhysicalDamageConcept.Hyperlink}."

msgid "RESARAVISTA@TRITDSCRIPT"
msgstr "When a friendly unit dies, this unit get {GLOBAL.PROPERTIES.BOLSTERED_DEFENSE.Hyperlink}, {GLOBAL.PROPERTIES.BOLSTERED_RESISTANCE.Hyperlink} and {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}."

msgid "WEAKH@TRITDSCRIPT"
msgstr "When this unit dies all friendly units with {GLOBAL.PROPERTIES.CULL_THE_WEAK.Hyperlink} gain {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink} and +10 {GLOBAL.UnitMoraleConcept.Hyperlink}."

msgid "FIREMUSKERT@E01@TRITDSCRIPT"
msgstr "Deal damage to target unit."

msgid "VOLTORB@E01@TRITDSCRIPT"
msgstr "Volatile Orbs"

